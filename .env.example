# Get an API key at https://resend.com
RESEND_API_KEY=re_xxxxxxxx

# Recipient for contact / RDV notifications
CONTACT_TO_EMAIL=you@example.com

# Verified sender in Resend (use onboarding@resend.dev for testing)
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Public site URL for metadata, sitemap, and Open Graph (no trailing slash)
# Example: https://example.com
NEXT_PUBLIC_SITE_URL=https://example.com

# ── MongoDB Atlas ────────────────────────────────────────────
# Format: mongodb+srv://USER:PASSWORD@HOST/DB?retryWrites=true&w=majority
# Le segment /DB est OBLIGATOIRE (ex. /portfolio) — sans lui Prisma P1013 / Atlas "empty database name".
# Même valeur dans .env (Prisma CLI) ET .env.local (Next.js / seed).
DATABASE_URL="mongodb+srv://USER:PASSWORD@HOST/portfolio?retryWrites=true&w=majority"

# ── NextAuth (Auth.js v4) ────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Générer avec: openssl rand -base64 32  (ou node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
NEXTAUTH_SECRET="remplace_par_un_secret_long_aleatoire"

# ── Admin unique (pas de table User) ─────────────────────────
ADMIN_EMAIL="admin@example.com"
# Hash bcrypt du mot de passe (jamais le plaintext ici / dans le code)
# Exemple génération: node -e "require('bcryptjs').hash('TON_MOT_DE_PASSE',12).then(console.log)"
ADMIN_PASSWORD_HASH="$2b$12$remplace_par_un_vrai_hash_bcrypt"

# ── Vercel Blob (upload images admin CMS) ────────────────────
# Vercel Dashboard → Storage → Blob → créer un store → copier le token RW
# Sans ce token, l’upload fichier échoue ; coller une URL image reste possible.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"
